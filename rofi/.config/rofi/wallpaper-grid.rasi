configuration {
    show-icons:         true;
    hover-select:       true;
    me-select-entry:    "MouseSecondary";
    me-accept-entry:    "MousePrimary";
}

window {
    width:              75%;
    height:             65%;
    anchor:             center;
    location:           center;
    border-radius:      16px;
    border:             2px;
    border-color:       #45475a; /* Sleek dark border */
    background-color:   #1e1e2e; /* Deep dark background */
}

mainbox {
    background-color:   transparent;
    children:           [ "inputbar", "listview" ];
    padding:            20px;
    spacing:            15px;
}

inputbar {
    background-color:   #313244;
    text-color:         #cdd6f4;
    border-radius:      10px;
    padding:            12px 16px;
    children:           [ "prompt", "entry" ];
}

prompt {
    background-color:   transparent;
    text-color:         #f38ba8;
    font:               "JetBrains Mono Bold 12";
}

entry {
    background-color:   transparent;
    text-color:         #cdd6f4;
    placeholder:        "Search wallpapers...";
    placeholder-color:  #6c7086;
    margin:             0px 0px 0px 10px;
}

listview {
    background-color:   transparent;
    columns:            4;  /* 4 columns of images side-by-side */
    lines:              3;
    spacing:            15px;
    flow:               horizontal;
}

element {
    background-color:   #252538;
    text-color:         #cdd6f4;
    orientation:        vertical; /* Puts image preview OVER the filename text */
    border-radius:      12px;
    padding:            15px;
    spacing:            10px;
}

element selected {
    background-color:   #45475a;
    text-color:         #f5c2e7;
    border:             2px;
    border-color:       #cba6f7; /* Soft purple outline on hover/select */
}

element-icon {
    background-color:   transparent;
    horizontal-align:   0.5;
    vertical-align:     0.5;

    /* --- FIXING THE SIZING ERROR --- */
    
    /* 1. Tell rofi to scale the thumbnail to fit the area */
    size:               200px; 
}

element-text {
    background-color:   transparent;
    /* text-color:         inherit; */
    text-color:         transparent;
    horizontal-align:   0.5;
    font:               "JetBrains Mono 10";
}
